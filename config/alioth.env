# KernelSU Action -- Redmi K40 (alioth) official KernelSU profile
#
# Official tiann/KernelSU, NOT ReSukiSU / SukiSU / KernelSU-Next.
# Manual builds track upstream main (KSU_REF=latest-test).
#
# Do NOT use liyafe1997 android15-lineage22-mod as a drop-in for the MIUI 13
# ROM boot. That Image matches the UTS string but uses a different display
# stack (fod dim lut parse fail / black panel). The live orig boot is Xiaomi
# V816.0.10.0.TKHCNXM: clang 10.0.7 NDK, builder pangu-..., KERNEL_SZ 50579472.
# Public source closest to that Android 13 generation is lineage-20 sm8250.

CONFIG_ENV=config/alioth.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/xiaomi-sm8250-devs/android_kernel_xiaomi_sm8250
KERNEL_SOURCE_BRANCH=lineage-20
KERNEL_CONFIG=vendor/kona-perf_defconfig vendor/xiaomi/sm8250-common.config vendor/xiaomi/alioth.config
KERNEL_IMAGE_NAME=Image
ARCH=arm64

KERNEL_NAME=alioth

ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS=LD=ld.lld KCFLAGS=-Wno-error
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
#
# Stock ROM is clang 10.0.7 + GNU ld 2.27; lineage-20 4.19.312 + KernelSU 3.x
# is built with ZyC clang 16 (same combo that already compiled 4.19 KSU 3.x).
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/ZyCromerZ/Clang/releases/download/16.0.6-20260510-release/Clang-16.0.6-20260510.tar.gz
CUSTOM_CLANG_BRANCH=

# ZyC clang 16 + GNU as 2.27 (AOSP GCC 4.9) cannot assemble vDSO:
#   arch/arm64/kernel/vdso/vgettimeofday.s  ".file" junk
# Live /proc/version used ZyC clang 16.0.6 + LLD 16.0.6, so use IAS+LLD.
USE_LLVM=true

# ===================================================================== GCC ==

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
#
# Official tiann/KernelSU only. Do not set resukisu / sukisu-ultra / kernelsu-next.
#
# latest-test = tiann/KernelSU main at build time (git describe).
# Each workflow_dispatch re-fetches that tip instead of pinning a release tag.
KSU_VARIANT=kernelsu
KSU_REF=latest-test
KSU_HOOK_MODE=kprobes

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==

ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=true

EXTRA_DEFCONFIG=CONFIG_LOCALVERSION_AUTO=n CONFIG_IKCONFIG=y CONFIG_IKCONFIG_PROC=y CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y CONFIG_KRETPROBES=y CONFIG_FTRACE=y CONFIG_TRACE_EVENTS=y CONFIG_FTRACE_SYSCALLS=y CONFIG_DEBUG_FS=y CONFIG_KPROBES=y CONFIG_HAVE_KPROBES=y CONFIG_KPROBE_EVENTS=y

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=false
REMOVE_UNUSED_PACKAGES=false

# ====================================================== uname camouflage ===
#
# Match the connected K40 ROM boot uname /proc/version:
#   4.19.157-perf-g92c089fc2d37 #1 SMP PREEMPT Wed Oct 29 11:41:46 UTC 2025
#   builder@pangu-build-component-vendor-727090-8pdx4-w2b4x-lb74b
FORCE_SUBLEVEL=157
KBUILD_BUILD_TIMESTAMP=Wed Oct 29 11:41:46 UTC 2025
KBUILD_BUILD_USER=builder
KBUILD_BUILD_HOST=pangu-build-component-vendor-727090-8pdx4-w2b4x-lb74b
KBUILD_BUILD_VERSION=1
SPOOF_LOCALVERSION=-g92c089fc2d37
